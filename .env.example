PORT=4173
HOST=0.0.0.0

# Enable Falcon's private control panel at /admin.html.
ENABLE_ADMIN=1
ADMIN_TOKEN=replace-with-a-long-random-secret

# Hosted deployments should use the private PostgreSQL URL from the host.
# Leave DATABASE_URL unset to keep using local JSON storage.
DATABASE_URL=postgresql://user:password@host:5432/dice_night
DATABASE_SSL=false
